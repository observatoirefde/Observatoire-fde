{"id":"bluesky:rp:did:plc:z7ktudp4uqrdbj5yyw6vw4tn:at://did:plc:lt6djmwn7tur57luvhf4zdi5/app.bsky.feed.post/3liasetldgc2j","platform":"bluesky","did":"did:plc:z7ktudp4uqrdbj5yyw6vw4tn","uri":"at://did:plc:lt6djmwn7tur57luvhf4zdi5/app.bsky.feed.post/3liasetldgc2j","cid":"bafyreibisrxpsprqoqo4nksymhq4bu3xgz5kfqfkph32dakguwtqhzmfny","auteur_did":"did:plc:lt6djmwn7tur57luvhf4zdi5","url":"https://bsky.app/profile/progresliberaux.bsky.social/post/3liasetldgc2j","date":"2025-02-15T22:48:52.756Z","type":"repost","indexe":"2025-02-15T22:48:52.756Z","text":"“Nous avons des atouts, des intérêts à défendre, des valeurs, l’Europe ne doit plus subir, elle doit agir. \nLe sursaut, c’est maintenant !”\n@agenetet.bsky.social","facets":[{"$type":"app.bsky.richtext.facet","features":[{"$type":"app.bsky.richtext.facet#mention","did":"did:plc:z7ktudp4uqrdbj5yyw6vw4tn"}],"index":{"byteEnd":173,"byteStart":152}}],"author":{"name":"Progressistes Libéraux","handle":"progresliberaux.bsky.social","url":"https://bsky.app/profile/progresliberaux.bsky.social"},"replyTo":null,"embed":{"video":{"thumb":"https://video.bsky.app/watch/did%3Aplc%3Alt6djmwn7tur57luvhf4zdi5/bafkreie4bfiq6g2qjmipdtbjzixmz7uklubqukx23g7eoamktf2mdqr33y/thumbnail.jpg","alt":""}},"labels":[],"collecte_le":"2026-11-20T16:25:24.668Z"},
