  transition:background .2s var(--ease),border-color .2s var(--ease),transform .2s var(--ease);animation:homeIn .5s var(--ease) both;animation-delay:calc(var(--d,0) * 30ms)}
.hp:hover,.hp:focus-visible,.hpn-dep:hover{background:rgba(255,255,255,.75);border-color:rgba(255,255,255,.95);outline:none;transform:translateX(2px)}
