.cand .bar{height:8px;border-radius:0 4px 4px 0;background:#ccc}
.cand .nm{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.duel{display:flex;height:24px;border-radius:7px;overflow:hidden;gap:2px;margin:6px 0 3px;font-size:11px;color:#fff;font-weight:600}
.duel div{display:flex;align-items:center;padding:0 7px;white-space:nowrap;overflow:hidden;text-shadow:0 1px 1px rgba(0,0,0,.15)}
.delta{font-variant-numeric:tabular-nums;font-weight:600}
.up{color:#2c6e9b}.down{color:#b4233c}

.notes{padding:16px 22px;font-size:12.5px;color:var(--ink2)}
.notes ul{margin:0;padding-left:18px}
.notes li{margin:5px 0}
.foot{max-width:1480px;margin:0 auto;padding:0 28px 28px;color:var(--muted);font-size:11.5px}

/* infobulle */
.tt{position:fixed;pointer-events:none;background:rgba(24,33,45,.88);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);color:#fff;font-size:12px;padding:7px 10px;border-radius:10px;z-index:60;display:none;max-width:280px;box-shadow:0 8px 24px rgba(20,30,45,.2)}

/* défilement discret */
#panel::-webkit-scrollbar,.tbl-wrap::-webkit-scrollbar,.qres::-webkit-scrollbar{width:8px;height:8px}
#panel::-webkit-scrollbar-thumb,.tbl-wrap::-webkit-scrollbar-thumb,.qres::-webkit-scrollbar-thumb{background:rgba(120,140,165,.35);border-radius:8px}

@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}

/* tablettes */
@media (max-width:1180px){
  .topbar{flex-wrap:wrap;gap:10px}
  .tabs{order:3;margin:0;width:100%;justify-content:center}
  .search{margin-left:auto}
  .grid{grid-template-columns:1fr}
