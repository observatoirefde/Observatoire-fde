/* ---------- Accueil ---------- */
body.is-home #subtabs, body.is-home .hero, body.is-home #methode{display:none}
.home{position:relative;margin-top:14px}
.home-geo{position:absolute;inset:-40px 0 -20px;z-index:-1;pointer-events:none;opacity:.55;
  background:
    repeating-linear-gradient(0deg, rgba(120,145,175,.10) 0 1px, transparent 1px 64px),
    repeating-linear-gradient(90deg, rgba(120,145,175,.08) 0 1px, transparent 1px 64px),
    radial-gradient(ellipse 60% 50% at 50% 55%, rgba(205,220,236,.55), rgba(205,220,236,0) 70%);
  -webkit-mask-image:radial-gradient(ellipse 75% 70% at 50% 50%,#000 40%,transparent 85%);mask-image:radial-gradient(ellipse 75% 70% at 50% 50%,#000 40%,transparent 85%)}
.home-head{text-align:center;max-width:900px;margin:2px auto 14px;animation:homeIn .6s var(--ease) both}
.home-eyebrow{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#4a6a8c}
.home-title{font-size:26px;line-height:1.18;letter-spacing:-.025em;margin:4px auto 6px;max-width:820px}
.home-lead{color:var(--ink2);font-size:14px;margin:0 auto;max-width:640px}
.home-entries{display:flex;flex-wrap:wrap;justify-content:center;gap:8px;margin-top:14px}
.home-entries button{font:inherit;font-size:13px;font-weight:700;color:var(--ink);cursor:pointer;text-align:left;padding:8px 14px;border-radius:14px;
  background:rgba(255,255,255,.62);border:1px solid rgba(255,255,255,.9);box-shadow:0 4px 16px rgba(40,62,92,.08),inset 0 1px 0 #fff;-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);transition:transform .25s var(--ease),box-shadow .25s var(--ease),background .25s}
.home-entries button small{display:block;font-weight:500;font-size:11px;color:var(--muted)}
.home-entries button:hover{transform:translateY(-2px);background:rgba(255,255,255,.85);box-shadow:0 10px 26px rgba(40,62,92,.12),inset 0 1px 0 #fff}
.home-grid{display:grid;grid-template-columns:270px minmax(0,1fr) 330px;gap:16px;align-items:stretch}
.home-people,.home-map,.home-panel{animation:homeIn .7s var(--ease) both}
.home-map{animation-delay:.06s} .home-panel{animation-delay:.12s}
