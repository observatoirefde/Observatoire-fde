.badge.pres{background:rgba(214,227,241,.95);color:#2b4566}
.badge.afe{background:rgba(232,236,241,.95);color:#4a5565}
.more-row{display:flex;justify-content:center;margin-top:14px}
#seBar{margin:0 0 14px}
#seBar .bar{display:flex;gap:2px;height:16px;border-radius:8px;overflow:hidden}
#seBar .bar span{display:block;min-width:0}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.chip{font:inherit;font-size:12px;color:var(--ink2);background:rgba(255,255,255,.75);border:1px solid rgba(255,255,255,.9);border-radius:999px;padding:4px 10px;cursor:pointer}
.chip:hover{background:#fff;color:var(--ink)}
.modal{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;padding:24px;background:rgba(28,40,56,.28);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);animation:fadeIn .2s var(--ease)}
.modal[hidden]{display:none}
.modal-card{width:min(640px,100%);max-height:calc(100vh - 48px);display:flex;flex-direction:column;background:rgba(250,252,254,.9);padding:0}
.modal-body{overflow:auto;padding:22px 24px 20px;display:flex;flex-direction:column;gap:12px}
