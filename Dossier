/* ---------- Accueil : carte en lévitation (version allégée) ---------- */
/* Carte détourée ; seule une translation verticale anime son conteneur (canevas net).
   Aucun filtre de flou animé : halo et ombre sont de simples dégradés. */
.home-map{position:relative;overflow:visible;display:flex;flex-direction:column;background:none;border:0;box-shadow:none;animation:none}
.home-map::before{content:"";position:absolute;inset:0 0 8%;z-index:0;pointer-events:none;border-radius:50%;
  background:radial-gradient(ellipse 52% 46% at 50% 46%,rgba(255,255,255,.88) 0%,rgba(232,240,248,.55) 45%,rgba(220,231,243,0) 100%)}
.hm-stage{position:relative;flex:1;display:flex;flex-direction:column;z-index:1}
.hm-shadow{position:absolute;left:10%;right:10%;bottom:-6px;height:40px;pointer-events:none;
  background:radial-gradient(ellipse 50% 50% at 50% 50%,rgba(40,62,92,.17) 0%,rgba(40,62,92,.08) 40%,rgba(40,62,92,0) 100%);
  transform-origin:50% 50%;animation:hmShadow 5.6s ease-in-out infinite alternate}
.hm-lift{flex:1;display:flex;flex-direction:column;transition:transform .6s var(--ease)}
.hm-float{flex:1;display:flex;flex-direction:column;animation:hmFloat 5.6s ease-in-out infinite alternate}
.hm-tilt{flex:1;display:flex;flex-direction:column;animation:none;transform:none}
.home-map #maphome{flex:1;min-height:560px;width:100%;background:transparent}
.home-maphint{position:relative;z-index:1;border-top:0;padding:6px 12px 0}
@keyframes hmFloat{from{transform:translateY(0)}to{transform:translateY(-10px)}}
@keyframes hmShadow{from{transform:scaleX(1);opacity:1}to{transform:scaleX(.86);opacity:.6}}
/* pendant l'utilisation (survol, déplacement, zoom), hors écran ou onglet masqué : la lévitation se fige */
.home-map:hover .hm-float,.home-map:hover .hm-shadow,
.home-map.is-paused .hm-float,.home-map.is-paused .hm-shadow{animation-play-state:paused}
@media (hover:hover){ .home-map:hover .hm-lift{transform:translateY(-3px)} }
/* panneaux de l'accueil : verre sans flou d'arrière-plan (coûteux), aspect conservé */
.home .home-people,.home .home-panel,.home-entries button{-webkit-backdrop-filter:none;backdrop-filter:none}
.home .home-people,.home .home-panel{background:rgba(255,255,255,.74)}
