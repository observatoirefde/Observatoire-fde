  .toolbar{padding:10px}
  .seg{display:flex;width:100%;overflow-x:auto} .seg button{flex:1 0 auto;padding:8px 10px}
  label.ctl{width:100%;flex-wrap:wrap} label.ctl select{width:100%}
  #map{height:400px} #map24{height:320px}
  #panel{padding:14px}
  .legend{font-size:11.5px;gap:4px 10px}
  .seatsbar .lg{font-size:11.5px}
  .proj{padding:4px 10px}
  th,td{padding:6px 5px;font-size:12px}
  #tbl th:nth-child(2),#tbl td:nth-child(2),#tbl th:nth-child(4),#tbl td:nth-child(4),#tbl th:nth-child(7),#tbl td:nth-child(7){display:none}
  #tbl td:nth-child(5){min-width:90px}
  #cmp24{min-width:560px}
  .cand{grid-template-columns:minmax(0,1fr) 70px 46px}
  .l24card{padding:14px}
