  .search{width:auto;flex:1;margin-left:0}
  .tabs{overflow-x:auto;justify-content:stretch}
  .tabs button{padding:8px 6px;font-size:12.5px;flex:1 1 0}
  .hero{padding:20px 14px 4px}
  h1{font-size:21px} .sub{font-size:13.5px}
